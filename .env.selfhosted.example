# ==============================================================================
# Omi Self-Hosted Configuration
# Copy to .env.selfhosted and fill in the required values.
# Run with: docker compose up -d
# ==============================================================================

# ==================== STORAGE: MinIO (replaces Google Cloud Storage) ====================
# MinIO credentials — change these before production use
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please

# MinIO S3 API endpoint (used internally by services)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_please
MINIO_REGION=us-east-1
MINIO_SSL=false

# Public URL for MinIO (for signed URLs and public assets)
# Set this to your external domain/IP if clients need to access files directly
# Example: http://your-server-ip:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Bucket names (auto-created by minio-init service)
BUCKET_SPEECH_PROFILES=omi-speech-profiles
BUCKET_POSTPROCESSING=omi-postprocessing
BUCKET_MEMORIES_RECORDINGS=omi-memories-recordings
BUCKET_PRIVATE_CLOUD_SYNC=omi-private-cloud-sync
BUCKET_TEMPORAL_SYNC_LOCAL=omi-private-cloud-sync
BUCKET_PLUGINS_LOGOS=omi-app-logos
BUCKET_APP_THUMBNAILS=omi-app-thumbnails
BUCKET_CHAT_FILES=omi-chat-files
BUCKET_DESKTOP_UPDATES=omi-desktop-updates

# ==================== VECTOR DB: Qdrant (replaces Pinecone) ====================
QDRANT_URL=http://qdrant:6333
# Optional API key (leave empty to disable auth)
QDRANT_API_KEY=

# ==================== CACHE: Redis ====================
REDIS_DB_HOST=redis
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=

# ==================== SPEECH-TO-TEXT: Faster-Whisper (replaces Deepgram) ====================
# Model size options: tiny, base, small, medium, large-v3
# - tiny/base: fast, lower accuracy (~1 GB RAM)
# - small: balanced (~2 GB RAM)
# - medium: good accuracy (~5 GB RAM)
# - large-v3: best accuracy (~10 GB RAM, recommended with GPU)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- GPU / RTX 4090 setup ----
# Prerequisites: install nvidia-container-toolkit on the Docker host, then:
#   1. Set the three vars below
#   2. Uncomment both `deploy:` blocks in docker-compose.yml (faster-whisper + faster-whisper-ws)
#   3. Rebuild: docker compose build faster-whisper faster-whisper-ws
#   4. Restart:  docker compose up -d faster-whisper faster-whisper-ws
#
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_MODEL_SIZE=large-v3   # large-v3 recommended when GPU VRAM >= 10 GB
# WHISPER_DOCKERFILE=docker/services/faster-whisper/Dockerfile.cuda
# WHISPER_WS_DOCKERFILE=docker/services/faster-whisper-ws/Dockerfile.cuda

FASTER_WHISPER_URL=http://faster-whisper:8001

# Streaming STT WebSocket (replaces Deepgram live transcription)
# When DEEPGRAM_API_KEY is empty, this is used for live audio streams
FASTER_WHISPER_WS_URL=ws://faster-whisper-ws:8002

# ==================== DIARIZER (speaker detection) ====================
DIARIZER_URL=http://diarizer:8080
# Required to download pyannote models from HuggingFace
HUGGINGFACE_TOKEN=

# ==================== LLM (still requires external API) ====================
# Option A: OpenAI (recommended)
OPENAI_API_KEY=sk-your-openai-key

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key

# Option C: Use a local LLM via OpenRouter (pay-per-token, open source models available)
# OPENROUTER_API_KEY=sk-or-your-key

# ==================== FIREBASE (Authentication) ====================
# Firebase Auth is still required for login (Google/Apple OAuth)
# Create a project at https://console.firebase.google.com
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
SERVICE_ACCOUNT_JSON=

# Firestore is still required for document storage
# (MinIO + Qdrant replace GCS + Pinecone, not Firestore)
GOOGLE_APPLICATION_CREDENTIALS=

# ==================== APP CONFIGURATION ====================
ADMIN_KEY=change_me_for_production
ENCRYPTION_SECRET=change_me_for_production_must_be_long_and_random

# External URL of the omi-backend service (used by pusher to call back)
BASE_API_URL=http://omi-backend:8080
HOSTED_PUSHER_API_URL=http://omi-pusher:8080

# ==================== OPTIONAL FEATURES ====================
# Leave blank to disable; services degrade gracefully

# ElevenLabs TTS (voice synthesis for chat responses)
ELEVENLABS_API_KEY=

# Deepgram (streaming STT — if set, used instead of Faster-Whisper for streaming)
# Leave empty to use Faster-Whisper for everything
DEEPGRAM_API_KEY=

# AssemblyAI (batch transcription alternative)
ASSEMBLYAI_API_KEY=

# Hume (emotion detection)
HUME_API_KEY=
HUME_CALLBACK_URL=

# Google Calendar / Gmail integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Perplexity (web search in RAG)
PERPLEXITY_API_KEY=

# Stripe (payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (phone calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ==================== TYPESENSE (self-hosted search) ====================
# Typesense is open source and can be self-hosted
# Add to docker-compose if needed: https://typesense.org/docs/guide/install-typesense.html
TYPESENSE_HOST=typesense
TYPESENSE_HOST_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense_api_key

# ==================== LOCAL LLM: Ollama (optional — replaces OpenAI) ====================
# Uncomment to use a local model instead of OpenAI.
# Requires the ollama service in docker-compose.yml (uncomment it there too).
# Steps:
#   1. Uncomment ollama service in docker-compose.yml
#   2. Set OLLAMA_BASE_URL below
#   3. Remove or leave OPENAI_API_KEY empty
#   4. Run: docker compose exec ollama ollama pull llama3.2
#
# Recommended models: llama3.2, mistral, qwen2.5, phi4
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# ==================== OBSERVABILITY (optional) ====================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omi-selfhosted
