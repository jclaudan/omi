# OSS+ Self-Hosted Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Supabase/PostgreSQL)
# ============================================
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omi
DB_USER=postgres

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=pnFVr104xJQYOi5UwmSCWbRa692NKqEo
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4YW1wbGUiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYxNDIwOTIwMCwiZXhwIjoxNjQ1ODQ1MjAwfQ.UJTIOA1f9sErKgE6bpmArrEGghU-3vhVYWMuNxqHCCk
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4YW1wbGUiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjE0MjA5MjAwLCJleHAiOjE2NDU3NDUyMDB9.DaYlNKVe0N-1UYx2l6kZjNSsGVLkLfKYYjvP4Hx3wkE

# ============================================
# Supabase API
# ============================================
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant_api_key_default

# ============================================
# Object Storage (MinIO)
# ============================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=omi-data
MINIO_USE_SSL=false

# ============================================
# Speech-to-Text (Faster-Whisper)
# ============================================
FASTER_WHISPER_URL=http://localhost:8001
FASTER_WHISPER_WS_URL=ws://localhost:8002
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=default

# ============================================
# LLM (Ollama or Cloud)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# Uncomment to use cloud LLM instead
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# ============================================
# Redis Cache (Optional)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379

# ============================================
# Backend API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://localhost:8080

# ============================================
# Mode Selection
# ============================================
OMI_DB_BACKEND=supabase
OMI_AUTH_BACKEND=supabase
OMI_STORAGE_BACKEND=minio

# ============================================
# Encryption
# ============================================
ENCRYPTION_SECRET=x2dvgm1o36F0Kkty8zMQDXaBJTcGHhYi
DATA_PROTECTION_LEVEL=enhanced

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Development/Admin
# ============================================
ADMIN_KEY=your-admin-key-for-development
DEBUG=false

# ============================================
# Cloudflare Tunnel (OPTIONAL)
# ============================================
# To enable public access via Cloudflare Tunnel:
# 1. Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# 2. Create a tunnel and get the token
# 3. Set the token below
# 4. Run: docker compose --profile tunnel up
#
# Leave empty to disable tunnel (default - use local IP access)
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# LLM Configuration (OSS+ uses OpenRouter)
# ============================================
# For OSS+: Get your API key from https://openrouter.ai/keys
# Supports all models including OpenAI embeddings via OpenRouter
OPENROUTER_API_KEY=

# For production: OpenAI API key (not needed for OSS+)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_ADMIN_KEY=your-admin-key

# ============================================
# Docker Network
# ============================================
DOCKER_NETWORK=omi-network
