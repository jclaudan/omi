# OSS+ Self-Hosted Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Supabase Alternative - PostgreSQL)
# ============================================
DB_NAME=omi
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=super-secret-jwt-token-change-me

# ============================================
# MinIO Object Storage Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ============================================
# API Configuration
# ============================================
# Local access (default)
API_BASE_URL=http://localhost:8000
# OR for network access from other devices:
# API_BASE_URL=http://<YOUR_LOCAL_IP>:8000

# ============================================
# Cloudflare Tunnel (OPTIONAL)
# ============================================
# To enable public access via Cloudflare Tunnel:
# 1. Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# 2. Create a tunnel and get the token
# 3. Set the token below
# 4. Run: docker compose --profile tunnel up
#
# Leave empty to disable tunnel (default - use local IP access)
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# Whisper STT Configuration
# ============================================
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
WHISPER_WORKERS=1

# ============================================
# Ollama LLM Configuration
# ============================================
OLLAMA_MODEL=llama2  # Set your preferred model
OLLAMA_HOST=0.0.0.0:11434

# ============================================
# Redis Configuration (Optional Cache)
# ============================================
REDIS_URL=redis://redis:6379
